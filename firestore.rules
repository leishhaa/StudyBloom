rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for beginner-friendly, secure rules
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: users can only read and update their own document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Notes: users can read and write only their own notes
    match /notes/{noteId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Flashcard Sets: users can read and write only their own sets
    match /flashcardSets/{setId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Quizzes: users can read and write only their own quizzes
    match /quizzes/{quizId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Quiz Results: users can read and write only their own results
    match /quizResults/{resultId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
