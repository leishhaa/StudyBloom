<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions for Firebase & Gemini AI -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notification Permission for Daily Revision Reminders (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage Permissions for Importing .txt Notes -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_studybloom_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_studybloom_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyBloom"
        tools:targetApi="31">

        <!-- Splash Activity: Application Launcher -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.StudyBloom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Container Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Notes & AI Upload Activity -->
        <activity
            android:name=".activities.NotesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Interactive Flashcard Activity -->
        <activity
            android:name=".activities.FlashcardActivity"
            android:exported="false" />

        <!-- Interactive Quiz Activity -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false" />

        <!-- Quiz Result & Feedback Activity -->
        <activity
            android:name=".activities.ResultActivity"
            android:exported="false" />

    </application>

</manifest>
